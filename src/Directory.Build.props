<Project>
	<PropertyGroup>
		<!-- Target framework -->
		<TargetFramework>net10.0</TargetFramework>

		<!-- Enable latest C# features and diagnostics -->
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Code quality & analysis. Warnings are errors locally so the
		     dev loop matches CI (.github/workflows/backend.yml passes
		     -warnaserror to dotnet build); previously the divergence
		     let analyzer regressions slip through to CI. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>

		<!-- Docs -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591;MSG0005;CA1054;CA1056</NoWarn>
		<!-- Suppress warning about missing XML docs -->

		<!-- Container tags (if using container builds) -->
		<ContainerImageTags>10.0.0;latest</ContainerImageTags>

		<!-- Prevent MSBuild from excluding common folders (optional) -->
		<NoDefaultExcludes>true</NoDefaultExcludes>
	</PropertyGroup>

	<!--
	  Local-feed profile for the opt-in FSH.Framework.* packages
	  (`fsh framework pack`, PackFshFramework=true + FshLocalPack=true).

	  A folder feed serves .nupkg only — .snupkg is resolved through the NuGet.org symbol
	  server, so the snupkg profile cannot give step-into debugging locally. Embedding the
	  PDB *and* the sources inside the DLL does: F11 lands in real framework source with no
	  symbol server, no source checkout and no network. Consumers must still turn OFF
	  "Just My Code" — see README-CLI.md.

	  These must be set HERE, not in Directory.Build.targets: the SDK derives DebugSymbols
	  (and thus whether a standalone .pdb is expected on disk) from DebugType before
	  Directory.Build.targets is imported. Setting DebugType late leaves the SDK expecting a
	  .pdb that the compiler embedded instead, and pack then fails with NU5026.
	-->
	<PropertyGroup Condition="'$(PackFshFramework)' == 'true' and '$(FshLocalPack)' == 'true'">
		<DebugType>embedded</DebugType>
		<EmbedAllSources>true</EmbedAllSources>
		<!-- EmbedAllSources already puts the sources in the PDB, so SourceLink adds nothing
		     here — and it warns on any remote it cannot map to github.com (SSH aliases,
		     self-hosted forks), which would be pure noise on every local pack. -->
		<EnableSourceLink>false</EnableSourceLink>
		<EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
	</PropertyGroup>

	<ItemGroup>
		<!-- Sonar Analyzer for deep static analysis -->
		<PackageReference Include="SonarAnalyzer.CSharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<PropertyGroup>
		<!-- Default NuGet metadata -->
		<Authors>Mukesh Murugan</Authors>
		<Company>FullStackHero</Company>
		<Version>10.0.0</Version>
		<RepositoryUrl>https://github.com/fullstackhero/dotnet-starter-kit</RepositoryUrl>
		<PackageTags>FSH;FullStackHero;Modular;CQRS;VerticalSlice;DotNet;CleanArchitecture</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://fullstackhero.net</PackageProjectUrl>
		<Description>FullStackHero .NET Starter Kit - A production-ready modular .NET framework for building enterprise applications</Description>
		<!--
		  Distribution model = SOURCE OWNERSHIP. Only TWO packages ship to NuGet.org:
		  FullStackHero.NET.StarterKit (template, in templates/) and FullStackHero.CLI
		  (src/Tools/CLI). The template scaffolds full, owned source; modules/framework
		  are consumed via ProjectReference, never as binary NuGets. So pack is OFF by
		  default here and explicitly re-enabled ONLY on the CLI. This prevents the 33
		  module/framework projects from accidentally emitting orphan, mutually-
		  unresolvable binary packages. CI (backend.yml) packs only those two projects.
		-->
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!--
	  NOTE: packaging settings that key off $(IsPackable) live in Directory.Build.targets,
	  not here. This file is imported BEFORE the project body, so a csproj that sets
	  IsPackable=true does so too late for any PropertyGroup condition here to see it —
	  which is exactly how FullStackHero.CLI ended up shipping without a .snupkg despite
	  IncludeSymbols appearing to be set. Directory.Build.targets is imported after the
	  project body, where IsPackable has its final value.
	-->

</Project>
