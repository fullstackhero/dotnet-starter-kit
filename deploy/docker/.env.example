# ──────────────────────────────────────────────────────────────────────
# FullStackHero — production docker-compose configuration.
# Copy to `.env` and edit. NEVER commit .env to git.
# Compose refuses to start until every required (?-flagged) var is set.
# ──────────────────────────────────────────────────────────────────────

# ── Public URLs ──────────────────────────────────────────────────────
# Where each surface is reachable from end users' browsers (via your
# external proxy / TLS terminator). Used by:
#   • frontends, baked into /config.json at container start
#   • API and RustFS CORS allow-lists for the two frontend origins
#   • FSH_S3_PUBLIC_URL: host the API signs presigned upload/download
#     URLs for (the RustFS S3 API, FSH_S3_PORT). SigV4 signs the Host
#     header, so your proxy must forward it unchanged. Public files are
#     served unsigned from FSH_S3_PUBLIC_URL/fsh/public/... (the bucket
#     grants anonymous read on public/* only).
FSH_API_URL=https://api.example.com
FSH_ADMIN_URL=https://admin.example.com
FSH_DASHBOARD_URL=https://app.example.com
FSH_S3_PUBLIC_URL=https://s3.example.com

# Default tenant identifier used by the login forms on first paint.
FSH_DEFAULT_TENANT=root

# ── Host ports for the external proxy to point at ───────────────────
# FSH services and the RustFS S3 API publish ports (browsers upload
# straight to it). Postgres/Redis stay compose-internal by default
# (uncomment their `ports:` blocks in docker-compose.yml if you need
# host access for psql / redis-cli).
FSH_API_PORT=8080
FSH_ADMIN_PORT=8081
FSH_DASHBOARD_PORT=8082
# Published on all interfaces: firewall it, or bind it to 127.0.0.1 in
# docker-compose.yml when your proxy runs on this host.
FSH_S3_PORT=9000

# Mailpit inbox UI. Bound to the host loopback only: open
# http://localhost:8025 on the Docker host.
FSH_MAILPIT_PORT=8025

# ── Mail ─────────────────────────────────────────────────────────────
# By default every e-mail goes to the bundled Mailpit catcher and is
# NEVER delivered. For real delivery: point FSH_SMTP_* at your provider
# (FSH_SMTP_SECURITY: StartTls on 587, SslOnConnect on 465) and delete
# the COMPOSE_PROFILES line so the catcher no longer runs.
COMPOSE_PROFILES=mail-catcher
FSH_SMTP_HOST=mailpit
FSH_SMTP_PORT=1025
FSH_SMTP_SECURITY=None
FSH_SMTP_USERNAME=
FSH_SMTP_PASSWORD=

# Sender address on every e-mail. Use a domain your provider accepts.
FSH_MAIL_FROM=no-reply@fsh.local

# ── Secrets ─────────────────────────────────────────────────────────
# JWT signing key — must be 32+ chars and NOT contain the substring
# "replace-with" (the framework's placeholder detector blocks that).
# Generate with:    openssl rand -base64 48
JWT_SIGNING_KEY=

# Initial root admin password the seeder uses on first boot. Sign in
# at https://admin.example.com with admin@root.com using this value,
# then rotate from Settings → Security immediately. Required.
SEED_ADMIN_PASSWORD=

# Hangfire dashboard credentials — MUST be set. UserName min 3 chars,
# Password min 12 chars (enforced at startup).
# Access the dashboard at <FSH_API_URL>/jobs after login.
HANGFIRE_USERNAME=
HANGFIRE_PASSWORD=

# ── Data plane (defaults are fine for self-hosted compose) ──────────
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# ── Observability (optional) ────────────────────────────────────────
# Point at an OTLP collector to ship traces/metrics. Leave blank to
# disable export. Example: http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
